/-! ## DST byte goldens -/

example : withdrawalDst.size = 36 := withdrawalDst_size
example : transferDst.size = 34 := transferDst_size
example : rotationDst.size = 34 := rotationDst_size
example : normalizationDst.size = 39 := normalizationDst_size

/-- Every DST must be unique (pairwise). A drift that collapses two
would make the corresponding two proof types challenge-interchangeable. -/
example : withdrawalDst ≠ transferDst := by
  intro h
  have hs : withdrawalDst.size = transferDst.size := by rw [h]
  rw [withdrawalDst_size, transferDst_size] at hs
  omega

example : withdrawalDst ≠ normalizationDst := by
  intro h
  have hs : withdrawalDst.size = normalizationDst.size := by rw [h]
  rw [withdrawalDst_size, normalizationDst_size] at hs
  omega

example : transferDst ≠ rotationDst := by
  intro h
  -- `transferDst` and `rotationDst` are both 34 bytes but differ in their
  -- protocol-name bytes after the shared `MovementConfidentialAsset/` prefix.
  have hne : transferDst.get! 26 ≠ rotationDst.get! 26 := by native_decide
  exact hne (by rw [h])

example : transferDst ≠ normalizationDst := by
  intro h
  have hs : transferDst.size = normalizationDst.size := by rw [h]
  rw [transferDst_size, normalizationDst_size] at hs
  omega

example : rotationDst ≠ normalizationDst := by
  intro h
  have hs : rotationDst.size = normalizationDst.size := by rw [h]
  rw [rotationDst_size, normalizationDst_size] at hs
  omega

example : withdrawalDst ≠ rotationDst := by
  intro h
  have hs : withdrawalDst.size = rotationDst.size := by rw [h]
  rw [withdrawalDst_size, rotationDst_size] at hs
  omega

