  native_decide

/-- `2^(-1) * 2 = 1` — defining property of the inverse. -/
example : scalarToBytes ((s 2)⁻¹ * s 2)
    = ByteArray.mk #[
        0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
