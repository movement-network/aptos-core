/-! ## Tier 3 Phase W.11 — multi-fixture FS-prefix SHA-512 binding

Phase W.10 bound ONE reference fixture (chain_id=9, @0xA/@0xB, amount=42,
ek=G, ek'=H). A bug that hard-codes the reference fixture on either
engine would slip through — every row would still pass. W.11 adds four
FIXTURE VARIANTS that vary each independent axis of the FS-prefix
input space, multiplying coverage:

  V2 (withdrawal): chain_id=0xff (max u8), amount=1, ek=G
       → exercises a regression that truncates/misinterprets the high
         chain_id bit or hard-codes amount=42.
  V3 (withdrawal): chain_id=1, amount=65535 (max u16, single chunk),
       ek=G → exercises chunk-boundary handling and hard-coded chain_id=9.
  V4 (normalization): SWAPPED addresses (sender=@0xB, contract=@0xA),
       chain_id=9 → exercises a sender/contract argument-order bug.
  V5 (rotation): SWAPPED eks (current_ek=H, new_ek=G), chain_id=0x42
       → exercises a current_ek/new_ek argument-order bug.

Each variant is constructed purely from already cross-bound primitives
(no new encodings introduced). The SHA-512 digest pin on each side
independently locks ~1 KB of byte content via preimage resistance. -/

/-- Withdrawal variant V2 fixture (837 B): chain_id=0xff, amount=1,
sender=A, contract=B, ek=G. -/
private def withdrawalFsPrefixBytesV2 : ByteArray :=
  withdrawalDst ++ prependDomainContext 0xff addrA addrB (
    ristrettoBasepointBytes ++
    confidentialAssetHashBaseBytes ++
    ristrettoBasepointBytes ++
    (scalarToBytes ((1 : ℕ) : RistrettoScalar) ++
     scalarToBytes ((0 : ℕ) : RistrettoScalar) ++
     scalarToBytes ((0 : ℕ) : RistrettoScalar) ++
     scalarToBytes ((0 : ℕ) : RistrettoScalar)) ++
    zeroActualBalanceBytes)

/-- Withdrawal variant V3 fixture (837 B): chain_id=1, amount=65535
(u16 max, fits in a single chunk), sender=A, contract=B, ek=G. -/
private def withdrawalFsPrefixBytesV3 : ByteArray :=
  withdrawalDst ++ prependDomainContext 1 addrA addrB (
    ristrettoBasepointBytes ++
    confidentialAssetHashBaseBytes ++
    ristrettoBasepointBytes ++
    (scalarToBytes ((65535 : ℕ) : RistrettoScalar) ++
     scalarToBytes ((0 : ℕ) : RistrettoScalar) ++
     scalarToBytes ((0 : ℕ) : RistrettoScalar) ++
     scalarToBytes ((0 : ℕ) : RistrettoScalar)) ++
    zeroActualBalanceBytes)

/-- Normalization variant V2 fixture (1224 B): SWAPPED addresses
(sender=B, contract=A), chain_id=9, ek=G. -/
private def normalizationFsPrefixBytesV2 : ByteArray :=
  normalizationDst ++ prependDomainContext 9 addrB addrA (
    ristrettoBasepointBytes ++
    confidentialAssetHashBaseBytes ++
    ristrettoBasepointBytes ++
    zeroActualBalanceBytes ++
    zeroActualBalanceBytes)

/-- Rotation variant V2 fixture (1251 B): SWAPPED eks (current_ek=H,
new_ek=G), chain_id=0x42, sender=A, contract=B. -/
private def rotationFsPrefixBytesV2 : ByteArray :=
  rotationDst ++ prependDomainContext 0x42 addrA addrB (
    ristrettoBasepointBytes ++
    confidentialAssetHashBaseBytes ++
    confidentialAssetHashBaseBytes ++
    ristrettoBasepointBytes ++
    zeroActualBalanceBytes ++
    zeroActualBalanceBytes)

/-- Variant sizes match their W.10 counterparts — sanity pin for the
structure of the new fixtures. -/
