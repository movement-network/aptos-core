/-! ## Tier 3 Phase W.5 — SHA-512 → `RistrettoScalar` end-to-end goldens

These pins compute `scalarToBytes (scalarUniformFrom64Bytes (sha2_512
input))` from scratch on the Lean side and compare the resulting 32
bytes to the same hex literal pinned in the Move VM rows
`test_new_scalar_from_sha2_512_*_tier3_binding`. Each row is a TRUE
two-engine algebraic binding:

- Lean side: `MovementFormal.AptosStd.Hash.Sha2_512.sha2_512` (FIPS
  180-4 reference implementation in pure Lean) → 64 bytes →
  `byteArrayLeNat` → `ZMod ℓ` → 32 LE bytes via `natLeByte`.
- Move side: `aptos_stdlib::aptos_hash::sha2_512` (libsodium / Rust
  native) → 64 bytes → `curve25519-dalek` `Scalar::from_bytes_mod_order_wide`
  → 32 LE bytes via `scalar_to_bytes`.

A drift in EITHER engine flips the pin. -/

private def sha2ToScalarBytes (msg : ByteArray) : ByteArray :=
  match scalarUniformFrom64Bytes (sha2_512 msg) with
  | some s => scalarToBytes s
  | none => ByteArray.empty

/-- Custom 30-byte input — exercises the multi-block boundary at 14
bytes from the start of the second 1024-bit SHA-512 block. -/
example :
    sha2ToScalarBytes "tier3-binding-sha512-to-scalar".toUTF8
    = ByteArray.mk #[
        0xe9, 0xd0, 0x87, 0x19, 0x0f, 0x54, 0x04, 0xd1,
        0x97, 0x3e, 0x80, 0x96, 0x91, 0x3a, 0x23, 0x07,
        0x63, 0xb2, 0x52, 0xe2, 0xb5, 0x1a, 0x32, 0x9a,
        0x16, 0x87, 0x3b, 0x29, 0xc2, 0xd1, 0xee, 0x05] := by
  native_decide

/-- Empty-input edge case — exercises SHA-512's empty-message
padding (single padding block: `0x80` then 117 zero bytes then 8
bytes of `0u64` length). -/
example :
    sha2ToScalarBytes "".toUTF8
    = ByteArray.mk #[
        0x9e, 0xf5, 0xa0, 0xea, 0x93, 0x67, 0x8e, 0xb7,
        0x8d, 0x69, 0xb3, 0x33, 0x67, 0xe1, 0x29, 0x54,
        0x3b, 0x0d, 0x85, 0x20, 0x12, 0x2c, 0x42, 0xe7,
        0xdf, 0xe9, 0xd1, 0x97, 0x7f, 0x6c, 0x3a, 0x0c] := by
  native_decide

/-- Classic `"abc"` 3-byte NIST FIPS 180-4 test-vector input — tiny
input, single SHA-512 block, partial padding. -/
example :
    sha2ToScalarBytes "abc".toUTF8
    = ByteArray.mk #[
        0xd1, 0x5d, 0xbe, 0xf2, 0x9a, 0xbf, 0x1f, 0xf2,
        0x9f, 0x9c, 0xf9, 0x1c, 0x4b, 0x75, 0xee, 0x0b,
        0xb1, 0x01, 0x2c, 0xb0, 0x31, 0xd9, 0x60, 0x5d,
        0x68, 0x4e, 0x84, 0x1d, 0xf0, 0x34, 0xde, 0x0b] := by
  native_decide

/-- DST-as-input variant — exercises a 36-byte input in the SHA-512
single-block path with a different padding length than `"abc"`. -/
example :
    sha2ToScalarBytes "MovementConfidentialAsset/Withdrawal".toUTF8
    = ByteArray.mk #[
        0x77, 0x4c, 0xf2, 0x33, 0x29, 0xd4, 0xd7, 0x11,
        0x14, 0xb6, 0x12, 0x6b, 0x8f, 0x22, 0x5e, 0x93,
        0x11, 0x7a, 0xb5, 0x2f, 0x63, 0x53, 0x19, 0x50,
        0x14, 0xea, 0x70, 0xd4, 0x14, 0x99, 0x35, 0x00] := by
  native_decide

/-- Output-length invariant: every input always yields exactly 32
bytes. -/
example : (sha2ToScalarBytes "anything".toUTF8).size = 32 := by
  native_decide

/-! ## Tier 3 Phase W.6 — `RistrettoScalar` arithmetic end-to-end goldens

Each row computes `scalarToBytes (op ...)` from scratch on the Lean
side (using Mathlib's `ZMod ℓ` instance) and pins the 32-byte result
to the same hex literal pinned in the matching VM rows
`test_scalar_*_tier3_binding`. A drift in EITHER engine flips the
pin (e.g. a wrong subgroup-order constant on either side, a drift
in `scalar_to_bytes` LE serialization, or a regression in the
`curve25519-dalek` scalar arithmetic). -/

private def s (n : ℕ) : RistrettoScalar := (n : RistrettoScalar)

/-- `3 + 5 = 8`. -/
example : scalarToBytes (s 3 + s 5)
    = ByteArray.mk #[
        0x08, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00] := by
  native_decide

/-- `5 - 3 = 2`. -/
example : scalarToBytes (s 5 - s 3)
    = ByteArray.mk #[
        0x02, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00] := by
  native_decide

/-- `3 - 5 = ℓ - 2` (modular subtraction underflow). The expected
bytes are the LE encoding of `ℓ - 2`. -/
example : scalarToBytes (s 3 - s 5)
    = ByteArray.mk #[
        0xeb, 0xd3, 0xf5, 0x5c, 0x1a, 0x63, 0x12, 0x58,
        0xd6, 0x9c, 0xf7, 0xa2, 0xde, 0xf9, 0xde, 0x14,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x10] := by
  native_decide

/-- `7 * 11 = 77 = 0x4d`. -/
example : scalarToBytes (s 7 * s 11)
    = ByteArray.mk #[
        0x4d, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00] := by
  native_decide

/-- `-1 = ℓ - 1`. The expected bytes are the LE encoding of
`ℓ - 1 = 2^252 + 27742317777372353535851937790883648492`. -/
example : scalarToBytes (-(s 1))
    = ByteArray.mk #[
        0xec, 0xd3, 0xf5, 0x5c, 0x1a, 0x63, 0x12, 0x58,
        0xd6, 0x9c, 0xf7, 0xa2, 0xde, 0xf9, 0xde, 0x14,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x10] := by
  native_decide

/-- `-0 = 0`. -/
example : scalarToBytes (-(s 0))
    = ByteArray.mk #[
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00] := by
  native_decide

/-- `7^(-1)` mod ℓ. The expected bytes are the LE encoding of the
canonical multiplicative inverse of 7 in `ZMod ℓ`. -/
example : scalarToBytes ((s 7)⁻¹)
    = ByteArray.mk #[
        0x22, 0xd5, 0x90, 0x9f, 0xba, 0x32, 0x27, 0x31,
        0x43, 0xcd, 0xfe, 0x84, 0x8d, 0xda, 0x1f, 0x4c,
        0x92, 0x24, 0x49, 0x92, 0x24, 0x49, 0x92, 0x24,
