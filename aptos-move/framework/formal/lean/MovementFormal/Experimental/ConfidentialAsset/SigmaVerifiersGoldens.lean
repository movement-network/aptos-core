  normalizationDst ++ prependDomainContext 0xff addrA addrB (
    ristrettoBasepointBytes ++
    confidentialAssetHashBaseBytes ++
    ristrettoBasepointBytes ++
    zeroActualBalanceBytes ++
    zeroActualBalanceBytes)

/-- Rotation FS prefix at chain_id = 0x00. -/
private def rotCid0 : ByteArray :=
  rotationDst ++ prependDomainContext 0 addrA addrB (
    ristrettoBasepointBytes ++
    confidentialAssetHashBaseBytes ++
    ristrettoBasepointBytes ++
    confidentialAssetHashBaseBytes ++
    zeroActualBalanceBytes ++
    zeroActualBalanceBytes)

/-- Rotation FS prefix at chain_id = 0xff. -/
