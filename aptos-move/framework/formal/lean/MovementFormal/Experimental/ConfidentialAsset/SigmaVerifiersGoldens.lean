/-! ## Tier 3 Phase W.10 — HOLY GRAIL: full FS-prefix cross-engine
    byte equality via SHA-512 digest pin

This layer closes the FS-prefix binding loop that Phases R + W.4–W.9
built up toward: on a specific fixture, the ENTIRE 837 / 1224 /
1251 / 1635-byte Fiat–Shamir transcript prefix is byte-identical
between the Move VM and the Lean formal model.

**VM side** (`difftest_confidential_proof_helpers::*_fs_prefix` +
`aptos_hash::sha2_512` via `test_sha2_512_of_*_fs_prefix_matches_
golden_tier3_binding`) composes the prefix from public APIs
mirroring the production layout exactly and hashes it.

**Lean side** (below) constructs the prefix purely from the formal
model: `withdrawalDst`, `prependDomainContext`, `scalarToBytes`,
`ristrettoBasepointBytes`, `confidentialAssetHashBaseBytes`, and
zero-balance byte fixtures. SHA-512 is then applied via
`Sha2_512.sha2_512`.

Both sides pin the same 64-byte golden. If the two 837 / 1224 /
1251 / 1635-byte sequences differ anywhere — a transposed field, a
missing ctx byte, a wrong ek encoding, an off-by-one in scalar
bytes, or a different H base — the digests diverge and exactly one
engine fails.

Fixture (same as the VM-side rows):
  chain_id = 9, sender = @0xA, contract = @0xB
  withdrawal:   ek = G, amount = 42, current_balance = zero actual
  normalization: ek = G, current / new = zero actual
  rotation:      cur_ek = G, new_ek = H, cur / new = zero actual
  transfer:      sender_ek = G, recipient_ek = H,
                 current / new = zero actual,
                 sender_amount / recipient_amount = zero pending,
                 auditor_eks / auditor_amounts = empty
-/

/-- 32 bytes of zeros — a single compressed-Ristretto-sized slot. -/
private def zeroBytes32 : ByteArray := ByteArray.mk (Array.replicate 32 0)

/-- Zero actual balance bytes: 8 C-chunks || 8 D-chunks, each 32
bytes, all zero = 512 bytes. Mirrors `confidential_balance::
balance_to_bytes(new_actual_balance_no_randomness())`. -/
private def zeroActualBalanceBytes : ByteArray :=
  zeroBytes32 ++ zeroBytes32 ++ zeroBytes32 ++ zeroBytes32 ++
  zeroBytes32 ++ zeroBytes32 ++ zeroBytes32 ++ zeroBytes32 ++
  zeroBytes32 ++ zeroBytes32 ++ zeroBytes32 ++ zeroBytes32 ++
  zeroBytes32 ++ zeroBytes32 ++ zeroBytes32 ++ zeroBytes32

/-- Zero pending balance bytes: 4 C-chunks || 4 D-chunks = 256 B.
Mirrors `confidential_balance::balance_to_bytes(
new_pending_balance_no_randomness())`. -/
private def zeroPendingBalanceBytes : ByteArray :=
  zeroBytes32 ++ zeroBytes32 ++ zeroBytes32 ++ zeroBytes32 ++
  zeroBytes32 ++ zeroBytes32 ++ zeroBytes32 ++ zeroBytes32

/-- D-half of zero pending balance: 4 * 32 = 128 B. Mirrors
`confidential_balance::balance_to_points_d` applied to
`new_pending_balance_no_randomness()` then compressed. -/
private def zeroPendingDBytes : ByteArray :=
  zeroBytes32 ++ zeroBytes32 ++ zeroBytes32 ++ zeroBytes32

/-- Lean-side fixture for the withdrawal FS prefix (837 B). -/
private def withdrawalFsPrefixBytes : ByteArray :=
  withdrawalDst ++ prependDomainContext 9 addrA addrB (
    ristrettoBasepointBytes ++
    confidentialAssetHashBaseBytes ++
    ristrettoBasepointBytes ++  -- ek = G
    (scalarToBytes ((42 : ℕ) : RistrettoScalar) ++
     scalarToBytes ((0 : ℕ) : RistrettoScalar) ++
     scalarToBytes ((0 : ℕ) : RistrettoScalar) ++
     scalarToBytes ((0 : ℕ) : RistrettoScalar)) ++
    zeroActualBalanceBytes)

/-- Lean-side fixture for the normalization FS prefix (1224 B). -/
private def normalizationFsPrefixBytes : ByteArray :=
  normalizationDst ++ prependDomainContext 9 addrA addrB (
    ristrettoBasepointBytes ++
    confidentialAssetHashBaseBytes ++
    ristrettoBasepointBytes ++
    zeroActualBalanceBytes ++
    zeroActualBalanceBytes)

/-- Lean-side fixture for the rotation FS prefix (1251 B). -/
private def rotationFsPrefixBytes : ByteArray :=
  rotationDst ++ prependDomainContext 9 addrA addrB (
    ristrettoBasepointBytes ++
    confidentialAssetHashBaseBytes ++
    ristrettoBasepointBytes ++
    confidentialAssetHashBaseBytes ++
    zeroActualBalanceBytes ++
    zeroActualBalanceBytes)

/-- Lean-side fixture for the transfer FS prefix (1635 B, 0 auditors). -/
private def transferFsPrefixBytes : ByteArray :=
  transferDst ++ prependDomainContext 9 addrA addrB (
    ristrettoBasepointBytes ++
    confidentialAssetHashBaseBytes ++
    ristrettoBasepointBytes ++
    confidentialAssetHashBaseBytes ++
    zeroActualBalanceBytes ++
    zeroPendingBalanceBytes ++
    zeroPendingDBytes ++
    zeroActualBalanceBytes)

/-- Size pins — each FS prefix has its documented size on Lean side. -/
example : withdrawalFsPrefixBytes.size = 837 := by native_decide
example : normalizationFsPrefixBytes.size = 1224 := by native_decide
