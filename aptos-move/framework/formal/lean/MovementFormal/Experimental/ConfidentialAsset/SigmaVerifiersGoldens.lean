/-- Auditor-count propagation into the full FS message. Different
auditor counts must yield different challenge scalars at the full
message level. -/
example : fsChallengeBytes tr1aMsgA ≠ fsChallengeBytes tr2aMsgA := by native_decide
example : fsChallengeBytes tr2aMsgA ≠ fsChallengeBytes tr3aMsgA := by native_decide
example : fsChallengeBytes tr1aMsgB ≠ fsChallengeBytes tr2aMsgB := by native_decide

/-- Auditor-order propagation into the full FS message. The 2-auditor
[G,H] variant must differ from the [H,G] swapped variant — catches
an auditor-loop reversal bug that propagates through the auditor X
emission step into the full message. -/
example : fsChallengeBytes tr2aMsgA    ≠ fsChallengeBytes tr2aSwapMsgA := by native_decide
example : fsChallengeBytes tr2aMsgB    ≠ fsChallengeBytes tr2aSwapMsgB := by native_decide

/-- Per-variant X-order distinctness (A: G vs B: H‖G). -/
example : fsChallengeBytes tr1aMsgA    ≠ fsChallengeBytes tr1aMsgB    := by native_decide
example : fsChallengeBytes tr2aMsgA    ≠ fsChallengeBytes tr2aMsgB    := by native_decide
example : fsChallengeBytes tr3aMsgA    ≠ fsChallengeBytes tr3aMsgB    := by native_decide
example : fsChallengeBytes tr2aSwapMsgA ≠ fsChallengeBytes tr2aSwapMsgB := by native_decide

/-- FS message with auditors differs from the auditor-less transfer
FS message (W.18 `trMsgA`). -/
example : fsChallengeBytes tr1aMsgA ≠ fsChallengeBytes trMsgA := by native_decide
example : fsChallengeBytes tr2aMsgA ≠ fsChallengeBytes trMsgA := by native_decide
example : fsChallengeBytes tr3aMsgA ≠ fsChallengeBytes trMsgA := by native_decide

