/-! ## Phase W.19 — extend full FS-MESSAGE axis for norm / rot / tr
to match W.17's 4-shape coverage density for withdrawal.

For each of the 3 non-withdrawal protocols we add 2 further shapes:
  * `{norm,rot,tr}MsgC` — prefix || G || H  (2 X-points, NON-swapped
     order; pair with `*MsgB` which is the swapped [H,G] variant so
     any X-order serialization drift inside the assembler flips BOTH
     the B-C challenge-distinctness pin AND the independent golden
     pin).
  * `{norm,rot,tr}MsgD` — prefix || G || G || G || H || H || H
     (6 X-points; matches `wdMsgD` for withdrawal in W.17 and stresses
     the "longer X-array concatenation" path).

3 protocols × 2 shapes × 2 bindings (SHA-512 + challenge scalar) =
12 new binding rows, landed as `test_{sha2_512,fs_challenge_scalar}_
of_{norm,rot,tr}_msg_{c,d}_tier3_binding` VM↔Lean rows in the
`confidential_proof` suite.
-/

/-- Normalization FS messages (W.19). -/
private def normMsgC : ByteArray :=
  normalizationFsPrefixBytes ++ ristrettoBasepointBytes ++ confidentialAssetHashBaseBytes
private def normMsgD : ByteArray :=
  normalizationFsPrefixBytes ++
    ristrettoBasepointBytes ++ ristrettoBasepointBytes ++ ristrettoBasepointBytes ++
    confidentialAssetHashBaseBytes ++ confidentialAssetHashBaseBytes ++ confidentialAssetHashBaseBytes

/-- Rotation FS messages (W.19). -/
private def rotMsgC : ByteArray :=
  rotationFsPrefixBytes ++ ristrettoBasepointBytes ++ confidentialAssetHashBaseBytes
private def rotMsgD : ByteArray :=
  rotationFsPrefixBytes ++
    ristrettoBasepointBytes ++ ristrettoBasepointBytes ++ ristrettoBasepointBytes ++
    confidentialAssetHashBaseBytes ++ confidentialAssetHashBaseBytes ++ confidentialAssetHashBaseBytes

/-- Transfer FS messages (W.19). -/
private def trMsgC : ByteArray :=
  transferFsPrefixBytes ++ ristrettoBasepointBytes ++ confidentialAssetHashBaseBytes
private def trMsgD : ByteArray :=
  transferFsPrefixBytes ++
    ristrettoBasepointBytes ++ ristrettoBasepointBytes ++ ristrettoBasepointBytes ++
    confidentialAssetHashBaseBytes ++ confidentialAssetHashBaseBytes ++ confidentialAssetHashBaseBytes

