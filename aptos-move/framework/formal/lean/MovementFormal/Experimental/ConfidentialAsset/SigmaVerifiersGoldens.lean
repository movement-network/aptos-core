with `0x0a` in the last slot (matches Aptos BCS). -/
private def addrA : Address32 :=
  { bytes := ByteArray.mk #[
      0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
      0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
