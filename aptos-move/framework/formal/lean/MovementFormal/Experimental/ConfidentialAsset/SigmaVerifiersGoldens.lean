/-! ## Tier 3 Phase W.13 — Transfer auditor-count FS-prefix + challenge-scalar binding

Every Phase W.10/W.11/W.12 transfer row uses ZERO auditors. But the
transfer protocol's auditor-loop iteration — concatenating each
auditor's `pubkey_to_bytes(ek)` (in the pre-balance block) and each
auditor's `balance_to_points_d(amount)` (in the post-recipient-amount
block, BEFORE the sender_amount D block) — is the single most
regression-prone surface of the entire FS-prefix assembly for transfer:

  * off-by-one in the auditor loop (auditor_count vs auditor_count+1)
  * reversed auditor order (iter backwards vs forwards)
  * auditor eks inserted in the wrong block (e.g. after current_balance
    instead of after recipient_ek)
  * auditor amounts D-points iterated with different index than eks
  * sender_amount D's placed BEFORE auditor D's instead of after
  * skipped auditor slots or duplicated auditor entries

W.13 pins the transfer FS prefix SHA-512 and its downstream challenge
scalar for 1, 2, and 3 auditors, plus a 2-auditor variant with SWAPPED
auditor eks — catching any auditor-iteration drift that collapses two
distinct auditor configurations to the same byte sequence. -/

/-- Transfer FS prefix with 1 auditor (ek = G, zero pending amount).
Size = 1635 + 32 (auditor ek) + 128 (auditor D block) = 1795 B. -/
private def transferFsPrefixBytes1A : ByteArray :=
  transferDst ++ prependDomainContext 9 addrA addrB (
    ristrettoBasepointBytes ++
    confidentialAssetHashBaseBytes ++
    ristrettoBasepointBytes ++
    confidentialAssetHashBaseBytes ++
    ristrettoBasepointBytes ++
    zeroActualBalanceBytes ++
    zeroPendingBalanceBytes ++
    zeroPendingDBytes ++
    zeroPendingDBytes ++
    zeroActualBalanceBytes)

/-- Transfer FS prefix with 2 auditors (eks = G, H). Size = 1955 B. -/
private def transferFsPrefixBytes2A : ByteArray :=
  transferDst ++ prependDomainContext 9 addrA addrB (
    ristrettoBasepointBytes ++
    confidentialAssetHashBaseBytes ++
    ristrettoBasepointBytes ++
    confidentialAssetHashBaseBytes ++
    ristrettoBasepointBytes ++
    confidentialAssetHashBaseBytes ++
    zeroActualBalanceBytes ++
    zeroPendingBalanceBytes ++
    zeroPendingDBytes ++
    zeroPendingDBytes ++
    zeroPendingDBytes ++
    zeroActualBalanceBytes)

/-- Transfer FS prefix with 3 auditors (eks = G, H, G). Size = 2115 B. -/
private def transferFsPrefixBytes3A : ByteArray :=
  transferDst ++ prependDomainContext 9 addrA addrB (
    ristrettoBasepointBytes ++
    confidentialAssetHashBaseBytes ++
    ristrettoBasepointBytes ++
    confidentialAssetHashBaseBytes ++
    ristrettoBasepointBytes ++
    confidentialAssetHashBaseBytes ++
    ristrettoBasepointBytes ++
    zeroActualBalanceBytes ++
    zeroPendingBalanceBytes ++
    zeroPendingDBytes ++
    zeroPendingDBytes ++
    zeroPendingDBytes ++
    zeroPendingDBytes ++
    zeroActualBalanceBytes)

/-- Transfer FS prefix with 2 auditors in SWAPPED order (eks = H, G).
Catches an auditor-iteration bug that reverses the auditor loop. -/
private def transferFsPrefixBytes2A_swapped : ByteArray :=
  transferDst ++ prependDomainContext 9 addrA addrB (
    ristrettoBasepointBytes ++
    confidentialAssetHashBaseBytes ++
    ristrettoBasepointBytes ++
    confidentialAssetHashBaseBytes ++
    confidentialAssetHashBaseBytes ++
    ristrettoBasepointBytes ++
    zeroActualBalanceBytes ++
    zeroPendingBalanceBytes ++
    zeroPendingDBytes ++
    zeroPendingDBytes ++
    zeroPendingDBytes ++
    zeroActualBalanceBytes)

/-- Size pins per auditor count: 1635 + 160·k for k auditors. -/
example : transferFsPrefixBytes1A.size = 1795 := by native_decide
example : transferFsPrefixBytes2A.size = 1955 := by native_decide
example : transferFsPrefixBytes3A.size = 2115 := by native_decide
example : transferFsPrefixBytes2A_swapped.size = 1955 := by native_decide

