example : validNumBits 8 := by unfold validNumBits; tauto
example : validNumBits 16 := by unfold validNumBits; tauto
example : validNumBits 32 := by unfold validNumBits; tauto
example : validNumBits 64 := by unfold validNumBits; tauto
