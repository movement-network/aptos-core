/-! ## Tier 3 Phase W.14 — chain_id boundary axis coverage for all 4 sigma protocols

Phases W.10/W.11 pin multiple chain_ids ONLY for withdrawal (`9` ref,
`0xff` V2, `1` V3). Normalization, rotation, and transfer have been
pinned on exactly one chain_id (`9` / `0x42` for rotation V2). A
regression in chain_id byte processing that only manifests on boundary
values (`0x00`, `0xff`) for non-withdrawal protocols — e.g. a
signed/unsigned mismatch that sign-extends only for `chain_id ≥ 0x80`,
a conditional branch that treats `chain_id = 0` as "missing" and
omits the byte, or a native that silently coerces `u8 → i8` — would
pass every W.10-W.13 row.

W.14 pins FS-prefix SHA-512 AND downstream challenge scalar for 7
new fixtures spanning the chain_id boundary axis:
  * `wdCid0` — withdrawal at chain_id = 0x00 (wd_ref at chain_id=9 +
     wd_v2 at 0xff + wd_v3 at 1 covered the non-boundary axis; 0 is
     the missing boundary value).
  * `normCid 0x00`, `normCid 0xff` — normalization at both boundaries.
  * `rotCid 0x00`, `rotCid 0xff` — rotation at both boundaries.
  * `trCid 0x00`, `trCid 0xff` — transfer (0 auditors) at both
     boundaries.
-/

/-- Withdrawal FS prefix at chain_id = 0x00 (boundary). -/
private def wdCid0 : ByteArray :=
  withdrawalDst ++ prependDomainContext 0 addrA addrB (
    ristrettoBasepointBytes ++
    confidentialAssetHashBaseBytes ++
    ristrettoBasepointBytes ++
    (scalarToBytes ((42 : ℕ) : RistrettoScalar) ++
     scalarToBytes ((0 : ℕ) : RistrettoScalar) ++
     scalarToBytes ((0 : ℕ) : RistrettoScalar) ++
     scalarToBytes ((0 : ℕ) : RistrettoScalar)) ++
    zeroActualBalanceBytes)

/-- Normalization FS prefix at chain_id = 0x00. -/
private def normCid0 : ByteArray :=
  normalizationDst ++ prependDomainContext 0 addrA addrB (
    ristrettoBasepointBytes ++
    confidentialAssetHashBaseBytes ++
    ristrettoBasepointBytes ++
    zeroActualBalanceBytes ++
    zeroActualBalanceBytes)

/-- Normalization FS prefix at chain_id = 0xff (max u8). -/
