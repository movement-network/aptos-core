ARG BASE_IMAGE=ghcr.io/movementlabsxyz/aptos-node:latest
FROM ${BASE_IMAGE}

# Minimal backup-focused image for PFN backups
# Builds on top of main aptos-node image and adds only backup tools

# Install backup-specific tools (restic, curl, jq)
RUN apt-get update && apt-get install -y \
restic \
curl \
jq \
&& rm -rf /var/lib/apt/lists/*

# Copy backup orchestrator script
COPY --chmod=0755 backup-orchestrator.sh /usr/local/bin/backup-orchestrator.sh

# Run backup orchestrator by default (instead of aptos-node directly)
ENTRYPOINT ["/usr/local/bin/backup-orchestrator.sh"]
CMD []
